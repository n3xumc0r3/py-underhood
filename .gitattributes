# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Markdown files: explicit LF
*.md text eol=lf

# Config files: explicit LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Shell scripts: explicit LF
*.sh text eol=lf

# Binary files (just in case)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
